async def tool_manage_file(action="read", path="", content="", **kw):
    p = Path(path).expanduser()
    try:
        if action == "read":
            return p.read_text(errors="replace")[:MAX_OUTPUT] if p.exists() else "file not found."
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content or "")
        return f"written: {p}"
    except Exception as e:
        return f"file error: {e}"


