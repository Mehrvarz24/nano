async def cmd_status(sess):
    import shutil
    r = {}
    try:
        with open("/proc/loadavg") as f:
            r["load"] = f.read().split()[:3]
        with open("/proc/meminfo") as f:
            mem = dict(l.split(":") for l in f.read().splitlines())
        total = int(mem["MemTotal"].split()[0]); avail = int(mem["MemAvailable"].split()[0])
        r["mem"] = f"{(total - avail) / 1048576:.1f}/{total / 1048576:.1f} GB"
        du = shutil.disk_usage("/")
        r["disk"] = f"{du.used / 2**30:.0f}/{du.total / 2**30:.0f} GB ({du.used * 100 // du.total}%)"
    except Exception:
        pass

    t = Table(show_header=False, box=None, padding=(0, 2))
    t.add_column(style="cyan", no_wrap=True)
    t.add_column()
    t.add_row("مدل", f"{sess.prov}/{sess.model}")
    t.add_row("پیام‌ها", str(len(sess.messages)))
    t.add_row("ابزارها", "روشن" if sess.tools_on else "خاموش")
    t.add_row("استدلال", "روشن" if sess.reasoning else "عادی")
    t.add_row("Load", " ".join(r.get("load", ["?"])))
    t.add_row("RAM", r.get("mem", "?"))
    t.add_row("دیسک", r.get("disk", "?"))
    t.add_row("uptime", f"{time.time() - boot_time():.0f}s" if False else uptime_str())
    console.print(Panel(t, title="[bold]وضعیت[/bold]", border_style="cyan"))


def uptime_str():
    try:
        with open("/proc/uptime") as f:
            s = float(f.read().split()[0])
        d, s = divmod(int(s), 86400)
        h, s = divmod(s, 3600)
        m, _ = divmod(s, 60)
        return (f"{d} روز " if d else "") + f"{h}:{m:02d} ساعت"
    except Exception:
        return "?"


def boot_time():
    return 0


def cmd_add_provider():
    try:
        name = console.input("[cyan]نام پروایدر:[/cyan] ").strip()
        url = console.input("[cyan]Base URL:[/cyan] ").strip()
        key = console.input("[cyan]API Key (خالی = از‌محیط):[/cyan] ").strip()
        mods = console.input("[cyan]مدل‌ها (با کاما):[/cyan] ").strip()
    except (EOFError, KeyboardInterrupt):
        return
    if not name or not url:
        console.print("[red]نام و آدرس لازم است.[/red]")
        return
    models = [m.strip() for m in mods.split(",") if m.strip()]
    c = db()
    c.execute("""INSERT INTO providers(name,base_url,key_env,api_key,models,source,created)
                 VALUES(?,?,?,?,?,?,?)
                 ON CONFLICT(name) DO UPDATE SET base_url=excluded.base_url,
                 api_key=excluded.api_key, models=excluded.models""",
              (name, url, "", key, json.dumps(models, ensure_ascii=False), "manual", time.time()))
    c.commit(); c.close()
    console.print(f"[green]✓[/green] پروایدر «{name}» ذخیره شد ({len(models)} مدل)")


