async def main():
    ensure_ready()
    cfg = load_cfg()
    provs = get_providers()
    if not provs:
        console.print(Panel(
            "[warn]هیچ پروایدری پیدا نشد.[/warn]\n\n"
            "۱) اگر Hermes داری: مطمئن شو [brand]~/.hermes/config.yaml[/brand] پروایدر دارد.\n"
            "۲) یا از داخل همین برنامه با [brand]/provider[/brand] یکی اضافه کن\n"
            "   (نام، Base URL، API Key، مدل‌ها).",
            title="[brand]راه‌اندازی[/brand]", border_style="#334155", padding=(1, 2)))
        # اجازه بده کاربر پروایدر اضافه کند
        try:
            ans = console.input("  [brand]می‌خواهی همین حالا پروایدر اضافه کنی؟[/brand] [dim][y/N][/dim] ").strip()
        except (EOFError, KeyboardInterrupt):
            ans = "n"
        if ans.lower() in ("y", "yes", "بله", "ب"):
            cmd_add_provider()
            provs = get_providers()
        if not provs:
            sys.exit(1)

    # انتخاب اولیه
    default_prov = cfg.get("provider") or provs[0]["name"]
    p = next((x for x in provs if x["name"] == default_prov), provs[0])
    model = cfg.get("model") or (p["models"][0] if p["models"] else "")

    sess = Session(p["name"], model)
    if SESS_FILE.exists() and cfg.get("autoload"):
        try:
            sess = Session.from_dict(json.loads(SESS_FILE.read_text()))
        except Exception:
            pass

    banner(sess)

    style = Style.from_dict({
        "prompt": "#38bdf8 bold",
        "dim": "#475569",
        "bottom-toolbar": "#334155 bg:#0f172a",
        "completion-menu.completion": "bg:#1e293b #e5e7eb",
        "completion-menu.completion.current": "bg:#334155 #7dd3fc bold",
        "scrollbar.background": "bg:#1e293b",
        "scrollbar.button": "bg:#334155",
    })
    ptk = PromptSession(
        history=FileHistory(str(CACHE / "history.txt")),
        style=style,
        completer=WordCompleter(
            ["/model", "/models", "/provider", "/new", "/reasoning", "/tools",
             "/stop", "/status", "/sys", "/history", "/save", "/load", "/clear",
             "/skills", "/skill", "/learn", "/forget",
             "/help", "/exit"], ignore_case=True),
    )

    while True:
        try:
            with patch_stdout():
                prompt_html = (f"<prompt>⚡ nano</prompt> <dim>❯</dim> ")
                raw = await ptk.prompt_async(PtHTML(prompt_html))
        except (EOFError, KeyboardInterrupt):
            console.print("\n[dim]خداحافظ 👋[/dim]")
            break

        text = raw.strip()
        if not text:
            continue

        # ── دستورها ──
        if text.startswith("/"):
            parts = text.split(maxsplit=1)
            cmd = parts[0].lower()
            arg = parts[1] if len(parts) > 1 else ""

            if cmd in ("/exit", "/quit", "/q"):
                console.print("[dim]خداحافظ 👋[/dim]")
                break
            elif cmd == "/help":
                cmd_help()
            elif cmd == "/model":
                if arg:
                    if "/" in arg:
                        pn, mn = arg.split("/", 1)
                        sess.prov, sess.model = pn, mn
                        console.print(f"[green]✓[/green] مدل → [cyan]{pn}/{mn}[/cyan]")
                    else:
                        sess.model = arg
                        console.print(f"[green]✓[/green] مدل → [cyan]{arg}[/cyan]")
                else:
                    await pick_model(sess)
            elif cmd == "/models":
                cmd_models()
            elif cmd == "/provider":
                cmd_add_provider()
            elif cmd == "/new":
                sess.messages = []
                console.print("[green]✓[/green] گفتگوی جدید")
            elif cmd == "/reasoning":
                sess.reasoning = not sess.reasoning
                console.print(f"[green]✓[/green] استدلال: "
                              f"{'[green]روشن[/green]' if sess.reasoning else '[dim]عادی[/dim]'}")
            elif cmd == "/tools":
                sess.tools_on = not sess.tools_on
                console.print(f"[green]✓[/green] ابزارها: "
                              f"{'[green]روشن[/green]' if sess.tools_on else '[red]خاموش[/red]'}")
            elif cmd == "/stop":
                sess.stop_flag = True
                console.print("[yellow]⏹ درخواست توقف ثبت شد[/yellow]")
            elif cmd == "/skills":
                rows = SK.list_skills()
                if not rows:
                    console.print("[dim]هنوز مهارتی نیست. بعد از حل یک مسئله، /learn بزن.[/dim]")
                else:
                    t = Table(title=f"مهارت‌ها ({len(rows)})", box=None, padding=(0, 2))
                    t.add_column("نام", style="cyan", no_wrap=True)
                    t.add_column("استفاده", justify="right")
                    t.add_column("توضیح", style="dim")
                    for r in rows:
                        t.add_row(r["name"], f"{r['uses']}×", r["description"][:60])
                    console.print(t)
                    st = SK.stats()
                    console.print(f"[dim]مجموع: {st['total']} مهارت · "
                                  f"{st['uses_total']} بار استفاده[/dim]")
            elif cmd == "/skill":
                if not arg:
                    console.print("[red]نام مهارت را بده: /skill <نام>[/red]")
                else:
                    r = SK.read_skill(arg.strip())
                    if r.get("error"):
                        console.print(f"[red]{r['error']}[/red]")
                    else:
                        console.print(Panel(Markdown(r["content"][:5000]),
                                            title=f"[bold]{arg}[/bold]",
                                            border_style="cyan"))
            elif cmd == "/learn":
                if len(sess.messages) < 2:
                    console.print("[red]اول یک مسئله را حل کن، بعد /learn[/red]")
                else:
                    last_u = next((m["content"] for m in reversed(sess.messages)
                                   if m["role"] == "user"), "")
                    last_a = next((m["content"] for m in reversed(sess.messages)
                                   if m["role"] == "assistant"), "")
                    nm = arg.strip() or re.sub(r"[^a-z0-9]+", "-",
                                               (last_u[:40].lower() or "lesson")).strip("-")
                    r = SK.learn_from_task(last_u[:120], last_a[:1800], nm,
                                           f"آموخته از: {last_u[:70]}")
                    if r.get("ok"):
                        console.print(f"[green]✓[/green] مهارت «{nm}» ذخیره شد "
                                      f"({r.get('mode', 'created')})")
                    else:
                        console.print(f"[red]{r.get('error')}[/red]")
            elif cmd == "/forget":
                if not arg:
                    console.print("[red]نام بده: /forget <نام>[/red]")
                else:
                    r = SK.delete_skill(arg.strip())
                    console.print(f"[green]✓ حذف شد: {arg}[/green]" if r.get("ok")
                                  else f"[red]{r.get('error')}[/red]")
            elif cmd == "/status":
                await cmd_status(sess)
            elif cmd == "/sys":
                if arg:
                    sess.system = arg
                    console.print("[green]✓[/green] شخصیت به‌روز شد")
                else:
                    console.print(Panel(sess.system[:600], title="System", border_style="dim"))
            elif cmd == "/history":
                if not sess.messages:
                    console.print("[dim]تاریخچه خالی است[/dim]")
                for m in sess.messages:
                    role = m["role"]
                    col = "green" if role == "user" else "cyan"
                    console.print(f"[{col}]{role}:[/{col}] {str(m.get('content',''))[:300]}")
            elif cmd == "/save":
                name = arg or "session"
                f = CACHE / f"{name}.json"
                f.write_text(json.dumps(sess.to_dict(), ensure_ascii=False, indent=1))
                console.print(f"[green]✓[/green] ذخیره شد: {f}")
            elif cmd == "/load":
                name = arg or "session"
                f = CACHE / f"{name}.json"
                if f.exists():
                    sess = Session.from_dict(json.loads(f.read_text()))
                    console.print(f"[green]✓[/green] بارگذاری شد ({len(sess.messages)} پیام)")
                else:
                    console.print(f"[red]پیدا نشد: {f}[/red]")
            elif cmd == "/clear":
                banner(sess)
            else:
                console.print(f"[red]دستور ناشناخته: {cmd}[/red] — /help")
            continue

        # ── پیام عادی ──
        sess.messages.append({"role": "user", "content": text})
        try:
            res = await run_agent_stream(sess, text)
        except (KeyboardInterrupt, asyncio.CancelledError):
            sess.stop_flag = False
            console.print("\n[yellow]⏹ با Ctrl+C متوقف شد[/yellow]")
            sess.messages.pop()
            continue

        console.print()
        if res.get("error"):
            console.print(Panel(f"[err]⚠ {_esc(res['error'])}[/err]", border_style="#7f1d1d",
                                title="[err]خطا[/err]", title_align="right", padding=(0, 2)))
            sess.messages.pop()      # پیام ناموفق را نگه ندار
            continue

        reply = res.get("reply", "")
        # پاکسازی: مدل‌های ضعیف ممکن است tool_call را به‌صورت متن چاپ کنند
        if not res.get("steps") and "tool_calls" in reply and "<" in reply:
            reply = "(مدل تلاش کرد ابزار را متنی تولید کند — دوباره بپرس یا مدل قوی‌تری انتخاب کن)"
        sess.messages.append({"role": "assistant", "content": reply})

        if reply.strip():
            console.print()
            console.print(Panel(Markdown(reply), border_style="#334155",
                                padding=(1, 2), title="[hint]پاسخ[/hint]",
                                title_align="right"))

        u = res.get("usage") or {}
        st = len(res.get("steps", []))
        bits = []
        if st:
            bits.append(f"[tool]{st} ابزار[/tool]")
        if u.get("total_tokens"):
            bits.append(f"[dim]{u['total_tokens']} توکن[/dim]")
        if bits:
            console.print("  " + "  [hint]·[/hint]  ".join(bits))
        console.print()


