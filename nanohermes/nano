async def cmd_status(sess):
    import shutil
    r = {}
    try:
        with open("/proc/loadavg") as f:
            r["load"] = f.read().split()[:3]
        with open("/proc/meminfo") as f:
            mem = dict(l.split(":") for l in f.read().splitlines())
        total = int(mem["MemTotal"].split()[0]); avail = int(mem["MemAvailable"].split()[0])
        r["mem"] = f"{(total - avail) / 1048576:.1f}/{total / 1048576:.1f} GB"
        du = shutil.disk_usage("/")
        r["disk"] = f"{du.used / 2**30:.0f}/{du.total / 2**30:.0f} GB ({du.used * 100 // du.total}%)"
    except Exception:
        pass

    t = Table(show_header=False, box=None, padding=(0, 2))
    t.add_column(style="cyan", no_wrap=True)
    t.add_column()
    t.add_row("model", f"{sess.prov}/{sess.model}")
    t.add_row("messages", str(len(sess.messages)))
    t.add_row("tools", "on" if sess.tools_on else "off")
    t.add_row("reasoning", "on" if sess.reasoning else "normal")
    t.add_row("Load", " ".join(r.get("load", ["?"])))
    t.add_row("RAM", r.get("mem", "?"))
    t.add_row("disk", r.get("disk", "?"))
    t.add_row("uptime", f"{time.time() - boot_time():.0f}s" if False else uptime_str())
    console.print(Panel(t, title="[bold]status[/bold]", border_style="cyan"))


def uptime_str():
    try:
        with open("/proc/uptime") as f:
            s = float(f.read().split()[0])
        d, s = divmod(int(s), 86400)
        h, s = divmod(s, 3600)
        m, _ = divmod(s, 60)
        return (f"{d}d " if d else "") + f"{h}:{m:02d}"
    except Exception:
        return "?"


def boot_time():
    return 0


def _catalog():
    """Load the bundled provider catalog (43 known endpoints)."""
    try:
