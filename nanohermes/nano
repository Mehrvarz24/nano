def db():
    c = sqlite3.connect(DB_PATH)
    c.row_factory = sqlite3.Row
    return c


def init_db():
    """Create tables (for a fresh install)."""
    c = db()
    c.execute("""CREATE TABLE IF NOT EXISTS providers (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT UNIQUE, base_url TEXT, key_env TEXT, api_key TEXT,
        models TEXT, source TEXT, created REAL)""")
    c.execute("""CREATE TABLE IF NOT EXISTS chats (
        id TEXT PRIMARY KEY, title TEXT, created REAL, updated REAL)""")
    c.execute("""CREATE TABLE IF NOT EXISTS messages (
        id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, role TEXT,
        content TEXT, steps TEXT, ts REAL)""")
    c.commit(); c.close()


def sync_hermes_providers():
    """Read Hermes providers from config.yaml (no keys - keys come from .env)."""
    cfgp = Path(CFG_DATA.get("hermes_config") or
                os.environ.get("HERMES_CONFIG") or (Path.home() / ".hermes" / "config.yaml"))
    if not cfgp.exists():
        return 0
    try:
        import yaml
        cfg = yaml.safe_load(cfgp.read_text()) or {}
    except Exception:
        return 0
    provs = cfg.get("providers") or {}
    if not isinstance(provs, dict):
        return 0
    n = 0
    c = db()
    for name, p in provs.items():
        if not isinstance(p, dict):
            continue
        url = p.get("base_url") or ""
        if not url:
            continue
        models = p.get("models") or []
        models = [m if isinstance(m, str) else (m.get("id") or "") for m in models]
        models = [m for m in models if m]
        if not models:
            continue
        c.execute("""INSERT INTO providers(name,base_url,key_env,api_key,models,source,created)
                     VALUES(?,?,?,?,?,?,?)
                     ON CONFLICT(name) DO UPDATE SET base_url=excluded.base_url,
                       key_env=excluded.key_env, models=excluded.models
                     WHERE providers.source='hermes'""",
                  (name, url, p.get("key_env") or "", "", json.dumps(models, ensure_ascii=False),
                   "hermes", time.time()))
        n += 1
    c.commit(); c.close()
    return n


def ensure_ready():
    """Bootstrap: create tables and sync providers."""
    init_db()
    try:
        c = db()
        cnt = c.execute("SELECT COUNT(*) FROM providers WHERE source='hermes'").fetchone()[0]
        c.close()
        if cnt == 0:
            sync_hermes_providers()
    except Exception:
        pass


def get_providers():
    c = db()
    rows = [dict(r) for r in c.execute("SELECT * FROM providers ORDER BY name")]
    c.close()
    for r in rows:
        try:
            r["models"] = json.loads(r.get("models") or "[]")
        except Exception:
            r["models"] = []
    return rows


def get_key(prov):
    if prov.get("api_key"):
        return prov["api_key"]
    ke = prov.get("key_env")
    if ke:
        if ke in os.environ:
            return os.environ[ke]
        try:
            for line in HERMES_ENV_FILE.read_text().splitlines():
                if line.startswith(ke + "="):
                    return line.split("=", 1)[1].strip()
        except Exception:
            pass
    return ""


# ==================== tool execution ====================
async def tool_run_bash(command="", **kw):
    if DANGER.search(command):
        return "blocked: destructive command refused."
    try:
        p = await asyncio.create_subprocess_shell(
            command, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
        try:
            out, _ = await asyncio.wait_for(p.communicate(), timeout=CMD_TIMEOUT)
        except asyncio.TimeoutError:
            p.kill()
            return f"timed out after {CMD_TIMEOUT}s"
        t = out.decode("utf-8", "replace")
        return (t[:MAX_OUTPUT] + f"\n... [{len(t)} bytes total]") if len(t) > MAX_OUTPUT else (t or "(no output)")
    except Exception as e:
        return f"error: {e}"


