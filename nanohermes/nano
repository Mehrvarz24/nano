def _pick(title, rows, default=0, hint=None):
    """Arrow-key picker with a numbered fallback for non-TTY stdin."""
    if not rows:
        return -1
    if hint:
        console.print(f"[dim]{hint}[/dim]")
    try:
        from prompt_toolkit.shortcuts import radiolist_dialog
        from prompt_toolkit.styles import Style as PTStyle
        from prompt_toolkit.formatted_text import HTML
        style = PTStyle.from_dict({
            "dialog": "bg:#0d0d0f", "dialog frame.label": "bg:#0d0d0f #c9a962 bold",
            "dialog.body": "bg:#0d0d0f #f0e9d8", "radio-selected": "bg:#c9a962 #0d0d0f bold",
            "radio-checked": "#c9a962 bold", "button": "bg:#1e293b #f0e9d8",
            "button.focused": "bg:#c9a962 #0d0d0f bold",
        })
        dlg = radiolist_dialog(
            title=title, text=HTML("<style fg='#94a3b8'>up/down move, Enter select, Esc cancel</style>"),
            values=[(str(i), r) for i, r in enumerate(rows)],
            default=str(default), style=style)
        # prompt_toolkit 3.0.4x+ returns an awaitable from run(); older versions a value.
        res = dlg.run()
        if hasattr(res, "__await__"):
            try:
                res = asyncio.get_event_loop().run_until_complete(res)
            except RuntimeError:
                res = asyncio.run(res)
        return int(res) if res is not None else -1
    except Exception:
        # fallback: numbered list
        console.print(f"[brand]{title}[/brand]")
        for i, r in enumerate(rows, 1):
            mark = "[accent]›[/accent]" if i-1 == default else " "
            console.print(f"  {mark} [bold]{i:2}[/bold]. {r}")
        try:
            a = console.input("  [dim]choice [1-%d, Enter=%d]:[/dim] " % (len(rows), default+1)).strip()
        except (EOFError, KeyboardInterrupt):
            return -1
        if not a:
            return default
        try:
            n = int(a) - 1
            return n if 0 <= n < len(rows) else -1
        except ValueError:
            return -1


def cmd_add_provider():
    """Add a provider: pick from the catalog or enter a custom endpoint."""
    cat = _catalog()
    if cat:
        rows = [f"{c['id']:<24} {c['name']}" for c in cat]
        rows.append("custom ................ enter manually")
        i = _pick("Add provider", rows, 0, "Pick a known endpoint, or 'custom' to type your own.")
        if i < 0:
            console.print("[dim]cancelled[/dim]")
            return
        if i < len(cat):
            pick = cat[i]
            name, url = pick["id"], pick["base_url"]
            env  = pick.get("env", "")
            console.print(f"\n  [brand]{pick['name']}[/brand]")
            console.print(f"  [dim]{url}[/dim]\n")
        else:
            name = url = env = ""
    else:
        name = url = env = ""

    def ask(label, dflt=""):
        label2 = f"{label} [dim]({dflt})[/dim]" if dflt else label
        try:
            v = console.input(f"  [cyan]{label2}:[/cyan] ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        return v or dflt

    if not name:
        name = ask("provider id", "")
        if name is None or not name:
            console.print("[red]provider id is required.[/red]"); return
    if not url:
        url = ask("Base URL", "")
        if url is None or not url:
            console.print("[red]Base URL is required.[/red]"); return

    key = ask("API key (blank = read from env var)", "")
    if key is None: key = ""

    # try to auto-detect models from /models
    models = []
    if url and key:
        try:
            import urllib.request
            req = urllib.request.Request(url.rstrip("/") + "/models",
                                         headers={"Authorization": f"Bearer {key}"})
            with urllib.request.urlopen(req, timeout=8) as r:
                data = json.loads(r.read().decode("utf-8", "replace"))
            models = [m.get("id") for m in (data.get("data") or []) if m.get("id")]
            console.print(f"  [green]✓[/green] detected [accent]{len(models)}[/accent] models")
        except Exception as e:
            console.print(f"  [dim]model auto-detect skipped ({type(e).__name__})[/dim]")

    if not models:
        mods = ask("models (comma separated)", "")
        models = [m.strip() for m in (mods or "").split(",") if m.strip()]

    c = db()
    c.execute("""INSERT INTO providers(name,base_url,key_env,api_key,models,source,created)
                 VALUES(?,?,?,?,?,?,?)
                 ON CONFLICT(name) DO UPDATE SET base_url=excluded.base_url,
                 api_key=excluded.api_key, models=excluded.models""",
              (name, url, env, key, json.dumps(models, ensure_ascii=False), "manual", time.time()))
    c.commit(); c.close()
    console.print(f"[green]✓[/green] provider [brand]{name}[/brand] saved "
                  f"([accent]{len(models)}[/accent] models)\n")


def cmd_remove_provider(name=None):
    """Delete a provider."""
    provs = get_providers()
    if not provs:
        console.print("[warn]no providers[/warn]"); return
    if not name:
        rows = [f"{p['name']:<22} {p.get('base_url','')[:52]}" for p in provs]
        i = _pick("Remove provider", rows, 0)
        if i < 0: console.print("[dim]cancelled[/dim]"); return
        name = provs[i]["name"]
    c = db(); c.execute("DELETE FROM providers WHERE name=?", (name,)); c.commit(); c.close()
    console.print(f"[green]✓[/green] removed [brand]{name}[/brand]")


def cmd_setup():
    """Interactive first-run setup, hermes-style."""
    console.print()
    console.print(Panel("[brand]Nano-Hermes setup[/brand]\n[dim]Configure a provider and a model.[/dim]",
                        border_style="#334155", padding=(1,2)))
    provs = get_providers()
    if not provs:
        console.print("\n[dim]No providers yet — let's add one.\n[/dim]")
        cmd_add_provider()
        provs = get_providers()
    if not provs:
        console.print("[red]still no providers — aborting[/red]"); return
    # pick provider
    rows = [f"{p['name']:<22} {p.get('base_url','')[:52]}" for p in provs]
    i = _pick("Default provider", rows, 0)
    if i < 0: return
    p = provs[i]
    models = p.get("models") or []
    if isinstance(models, str):
        try: models = json.loads(models or "[]")
        except Exception: models = []
    if models:
        j = _pick("Default model", models, 0)
        model = models[j] if j >= 0 else models[0]
    else:
        try: model = console.input("  [cyan]model id:[/cyan] ").strip()
        except (EOFError, KeyboardInterrupt): return
    c = load_cfg(); c["provider"] = p["name"]; c["model"] = model; save_cfg(c)
    console.print(f"\n[green]✓[/green] ready — [brand]{p['name']}[/brand] / [accent]{model}[/accent]")
    console.print("[dim]run `nano` to start chatting[/dim]\n")


# ═══════════════════ MAIN ═══════════════════
async def main():
    # ── command-line arguments (hermes-style) ──
    argv = [a for a in sys.argv[1:]]
    if argv:
        a0 = argv[0].lstrip("/").lower()
        if a0 in ("setup", "init", "configure", "provider", "add-provider"):
            ensure_ready()
            if a0 == "provider" and len(argv) > 1:
                argv = argv[1:]
                # nano provider add / remove / list
                sub = argv[0].lower()
                if sub in ("add", "new"):     cmd_add_provider(); return
                if sub in ("rm", "remove", "del", "delete"):
                    cmd_remove_provider(argv[1] if len(argv) > 1 else None); return
                if sub in ("list", "ls"):
                    for p in get_providers():
                        console.print(f"[brand]{p['name']}[/brand] [dim]{p.get('base_url','')}[/dim]"); return
            cmd_setup() if a0 in ("setup","init","configure") else cmd_add_provider()
            return
        if a0 in ("help", "h", "-h", "--help"):
            cmd_help(); return
        if a0 in ("version", "-v", "--version"):
            console.print(f"[brand]nano[/brand] [accent]{VERSION}[/accent]"); return
        if a0 in ("skills", "skill"):
            from skills import list_skills
            cmd_skills() if "cmd_skills" in globals() else [console.print(f"[brand]{n}[/brand] [dim]{d}[/dim]") for n,d in list_skills()]
            return
        if a0 in ("providers", "models"):
            ensure_ready()
            cmd_models() if a0 == "models" else [console.print(f"[brand]{p['name']}[/brand]") for p in get_providers()]
            return
        # unknown → treat as a one-shot question
        ensure_ready()
        cfg = load_cfg(); provs = get_providers()
        if provs:
            p = next((x for x in provs if x["name"] == cfg.get("provider")), provs[0])
            sess = Session(p["name"], cfg.get("model") or (p["models"][0] if p["models"] else ""))
            banner(sess)
            await sess.ask(" ".join(argv))
            return
        console.print(f"[warn]unknown command:[/warn] {argv[0]}")
        console.print("[dim]try: nano setup | nano provider add | nano help[/dim]")
        return

    ensure_ready()
    cfg = load_cfg()
    provs = get_providers()
    if not provs:
        console.print(Panel(
            "[warn]No providers found.[/warn]\n\n"
            "1) If you have Hermes: make sure [brand]~/.hermes/config.yaml[/brand] has providers.\n"
            "2) Or add one right here with [brand]/provider[/brand]\n"
            "   (name, base URL, API key, models).",
            title="[brand]setup[/brand]", border_style="#334155", padding=(1, 2)))
        # let the user add a provider right away
        try:
            ans = console.input("  [brand]Add a provider now?[/brand] [dim][y/N][/dim] ").strip()
        except (EOFError, KeyboardInterrupt):
            ans = "n"
        if ans.lower() in ("y", "yes"):
            cmd_add_provider()
            provs = get_providers()
        if not provs:
            sys.exit(1)

    # initial model selection
    default_prov = cfg.get("provider") or provs[0]["name"]
    p = next((x for x in provs if x["name"] == default_prov), provs[0])
    model = cfg.get("model") or (p["models"][0] if p["models"] else "")

    sess = Session(p["name"], model)
    if SESS_FILE.exists() and cfg.get("autoload"):
        try:
            sess = Session.from_dict(json.loads(SESS_FILE.read_text()))
        except Exception:
            pass

    banner(sess)

    style = Style.from_dict({
        "prompt": "#38bdf8 bold",
        "dim": "#475569",
        "bottom-toolbar": "#334155 bg:#0f172a",
        "completion-menu.completion": "bg:#1e293b #e5e7eb",
        "completion-menu.completion.current": "bg:#334155 #7dd3fc bold",
        "scrollbar.background": "bg:#1e293b",
        "scrollbar.button": "bg:#334155",
    })
    ptk = PromptSession(
        history=FileHistory(str(CACHE / "history.txt")),
        style=style,
        completer=WordCompleter(
            ["/model", "/models", "/provider", "/new", "/reasoning", "/tools",
             "/stop", "/status", "/sys", "/history", "/save", "/load", "/clear",
             "/skills", "/skill", "/learn", "/forget",
             "/help", "/exit"], ignore_case=True),
    )

    while True:
        try:
            with patch_stdout():
                prompt_html = (f"<prompt>⚡ nano</prompt> <dim>❯</dim> ")
                raw = await ptk.prompt_async(PtHTML(prompt_html))
        except (EOFError, KeyboardInterrupt):
            console.print("\n[dim]bye 👋[/dim]")
            break

        text = raw.strip()
        if not text:
            continue

        # -- slash commands --
        if text.startswith("/"):
            parts = text.split(maxsplit=1)
            cmd = parts[0].lower()
            arg = parts[1] if len(parts) > 1 else ""

            if cmd in ("/exit", "/quit", "/q"):
                console.print("[dim]bye 👋[/dim]")
                break
            elif cmd == "/help":
                cmd_help()
            elif cmd == "/model":
                if arg:
                    if "/" in arg:
                        pn, mn = arg.split("/", 1)
                        sess.prov, sess.model = pn, mn
                        console.print(f"[green]ok[/green] model -> [cyan]{pn}/{mn}[/cyan]")
                    else:
                        sess.model = arg
                        console.print(f"[green]ok[/green] model -> [cyan]{arg}[/cyan]")
                else:
                    await pick_model(sess)
            elif cmd == "/models":
                cmd_models()
            elif cmd == "/provider":
                cmd_add_provider()
            elif cmd == "/new":
                sess.messages = []
                console.print("[green]ok[/green] new conversation")
            elif cmd == "/reasoning":
                sess.reasoning = not sess.reasoning
                console.print(f"[green]ok[/green] reasoning: "
                              f"{'[green]deep[/green]' if sess.reasoning else '[dim]normal[/dim]'}")
            elif cmd == "/tools":
                sess.tools_on = not sess.tools_on
                console.print(f"[green]ok[/green] tools: "
                              f"{'[green]on[/green]' if sess.tools_on else '[red]off[/red]'}")
            elif cmd == "/stop":
                sess.stop_flag = True
                console.print("[yellow]stop requested[/yellow]")
            elif cmd == "/skills":
                rows = SK.list_skills()
                if not rows:
                    console.print("[dim]no skills yet. after solving something, run /learn.[/dim]")
                else:
                    t = Table(title=f"skills ({len(rows)})", box=None, padding=(0, 2))
                    t.add_column("name", style="cyan", no_wrap=True)
                    t.add_column("uses", justify="right")
                    t.add_column("description", style="dim")
                    for r in rows:
                        t.add_row(r["name"], f"{r['uses']}×", r["description"][:60])
                    console.print(t)
                    st = SK.stats()
                    console.print(f"[dim]total: {st['total']} skills - "
                                  f"{st['uses_total']} uses[/dim]")
            elif cmd == "/skill":
                if not arg:
                    console.print("[red]skill name required: /skill <name>[/red]")
                else:
                    r = SK.read_skill(arg.strip())
                    if r.get("error"):
                        console.print(f"[red]{r['error']}[/red]")
                    else:
                        console.print(Panel(Markdown(r["content"][:5000]),
                                            title=f"[bold]{arg}[/bold]",
                                            border_style="cyan"))
            elif cmd == "/learn":
                if len(sess.messages) < 2:
                    console.print("[red]solve something first, then use /learn[/red]")
                else:
                    last_u = next((m["content"] for m in reversed(sess.messages)
                                   if m["role"] == "user"), "")
                    last_a = next((m["content"] for m in reversed(sess.messages)
                                   if m["role"] == "assistant"), "")
                    nm = arg.strip() or re.sub(r"[^a-z0-9]+", "-",
                                               (last_u[:40].lower() or "lesson")).strip("-")
                    r = SK.learn_from_task(last_u[:120], last_a[:1800], nm,
                                           f"learned from: {last_u[:70]}")
                    if r.get("ok"):
                        console.print(f"[green]ok[/green] skill '{nm}' saved "
                                      f"({r.get('mode', 'created')})")
                    else:
                        console.print(f"[red]{r.get('error')}[/red]")
            elif cmd == "/forget":
                if not arg:
                    console.print("[red]name required: /forget <name>[/red]")
                else:
                    r = SK.delete_skill(arg.strip())
                    console.print(f"[green]deleted: {arg}[/green]" if r.get("ok")
                                  else f"[red]{r.get('error')}[/red]")
            elif cmd == "/status":
                await cmd_status(sess)
            elif cmd == "/sys":
                if arg:
                    sess.system = arg
                    console.print("[green]ok[/green] persona updated")
                else:
                    console.print(Panel(sess.system[:600], title="System", border_style="dim"))
            elif cmd == "/history":
                if not sess.messages:
                    console.print("[dim]history is empty[/dim]")
                for m in sess.messages:
                    role = m["role"]
                    col = "green" if role == "user" else "cyan"
                    console.print(f"[{col}]{role}:[/{col}] {str(m.get('content',''))[:300]}")
            elif cmd == "/save":
                name = arg or "session"
                f = CACHE / f"{name}.json"
                f.write_text(json.dumps(sess.to_dict(), ensure_ascii=False, indent=1))
                console.print(f"[green]ok[/green] saved: {f}")
            elif cmd == "/load":
                name = arg or "session"
                f = CACHE / f"{name}.json"
                if f.exists():
                    sess = Session.from_dict(json.loads(f.read_text()))
                    console.print(f"[green]ok[/green] loaded ({len(sess.messages)} messages)")
                else:
                    console.print(f"[red]not found: {f}[/red]")
            elif cmd == "/clear":
                banner(sess)
            else:
                console.print(f"[red]unknown command: {cmd}[/red] - try /help")
            continue

        # -- normal message --
        sess.messages.append({"role": "user", "content": text})
        try:
            res = await run_agent_stream(sess, text)
        except (KeyboardInterrupt, asyncio.CancelledError):
            sess.stop_flag = False
            console.print("\n[yellow]interrupted with Ctrl+C[/yellow]")
            sess.messages.pop()
            continue

        console.print()
        if res.get("error"):
            console.print(Panel(f"[err]⚠ {_esc(res['error'])}[/err]", border_style="#7f1d1d",
                                title="[err]error[/err]", title_align="right", padding=(0, 2)))
            sess.messages.pop()      # do not keep the failed message
            continue

        reply = res.get("reply", "")
        # cleanup: weak models may print a tool call as plain text
        if not res.get("steps") and "tool_calls" in reply and "<" in reply:
            reply = "(the model tried to emit a tool call as text - retry or pick a stronger model)"
        sess.messages.append({"role": "assistant", "content": reply})

        if reply.strip():
            console.print()
            console.print(Panel(Markdown(reply), border_style="#334155",
                                padding=(1, 2), title="[hint]reply[/hint]",
                                title_align="right"))

        u = res.get("usage") or {}
        st = len(res.get("steps", []))
        bits = []
        if st:
            bits.append(f"[tool]{st} tools[/tool]")
        if u.get("total_tokens"):
            bits.append(f"[dim]{u['total_tokens']} tokens[/dim]")
        if bits:
            console.print("  " + "  [hint]·[/hint]  ".join(bits))
        console.print()


