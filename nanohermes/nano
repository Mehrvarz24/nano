# ==================== session ====================
class Session:
    def __init__(self, prov, model, system=None):
        self.prov = prov
        self.model = model
        self.system = system or DEFAULT_SYS
        self.messages = []
        self.reasoning = False
        self.tools_on = True
        self.stop_flag = False

    def to_dict(self):
        return {"prov": self.prov, "model": self.model, "system": self.system,
                "messages": self.messages, "reasoning": self.reasoning,
                "tools_on": self.tools_on}

    @classmethod
    def from_dict(cls, d):
        s = cls(d.get("prov", ""), d.get("model", ""), d.get("system"))
        s.messages = d.get("messages", [])
        s.reasoning = d.get("reasoning", False)
        s.tools_on = d.get("tools_on", True)
        return s


# ═══════════════════ LLM ═══════════════════
async def llm(prov, model, messages, tools=True, temperature=0.4, reasoning=False):
    key = get_key(prov)
    if not key:
        return {"error": f"no API key found for provider '{prov['name']}'"}
    url = prov["base_url"].rstrip("/") + "/chat/completions"
    body = {"model": model, "messages": messages, "temperature": temperature, "stream": False}
    if tools:
        body["tools"] = TOOLS
        body["tool_choice"] = "auto"
    if reasoning:
        # OpenAI-compatible providers - common parameters
        body["reasoning_effort"] = "high"
    headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
    try:
        async with ClientSession() as s:
            async with s.post(url, json=body, headers=headers, timeout=180) as r:
                data = await r.json(content_type=None)
        if not isinstance(data, dict):
            return {"error": "invalid response from provider"}
        if data.get("error"):
            e = data["error"]
            return {"error": e if isinstance(e, str) else (e.get("message") or str(e))}
        ch = (data.get("choices") or [{}])[0]
        return {"message": ch.get("message") or {}, "usage": data.get("usage")}
    except Exception as e:
        return {"error": f"provider error: {e}"}


# ==================== agent loop ====================
async def run_agent(sess, user_text):
    provs = {p["name"]: p for p in get_providers()}
    prov = provs.get(sess.prov)
    if not prov:
        return {"error": f"provider not found: '{sess.prov}'"}

    system = sess.system
    if sess.tools_on:
        try:
            import skills as SK
            ctx = SK.build_context(user_text, max_chars=2500, top=2)
            if ctx:
                system += "\n\n" + ctx
        except Exception:
            pass
    if not sess.tools_on:
        system += "\n\nTools are DISABLED. Answer from your own knowledge only; do not emit any tool call."
    msgs = [{"role": "system", "content": system}] + sess.messages \
        + [{"role": "user", "content": user_text}]
    steps = []

    for _ in range(MAX_STEPS):
        if sess.stop_flag:
            sess.stop_flag = False
            return {"reply": "stopped.", "steps": steps}

        res = await llm(prov, sess.model, msgs, tools=sess.tools_on, reasoning=sess.reasoning)
        if "error" in res:
            return {"error": res["error"], "steps": steps}

        msg = res["message"] or {}
        tcs = msg.get("tool_calls") or []
        content = msg.get("content") or ""

        if not tcs:
            return {"reply": content or "(no response)", "steps": steps, "usage": res.get("usage")}

        msgs.append({"role": "assistant", "content": content, "tool_calls": tcs})
        for tc in tcs:
            fn = tc.get("function") or {}
            name = fn.get("name")
            try:
                args = json.loads(fn.get("arguments") or "{}")
            except Exception:
                args = {}

            icon = TOOL_ICON.get(name, "🔧")
            arg_txt = json.dumps(args, ensure_ascii=False)
            if len(arg_txt) > 90:
                arg_txt = arg_txt[:87] + "…"
            console.print(f"  [dim]{icon} {name}[/dim] [dim italic]{arg_txt}[/dim italic]")

            t0 = time.time()
            out = (await TOOL_FN[name](**args)) if name in TOOL_FN else f"unknown tool: {name}"
            ms = int((time.time() - t0) * 1000)
            ok = not str(out).startswith(("error", "blocked", "timed out"))

            first = str(out).strip().splitlines()[0][:100] if str(out).strip() else ""
            console.print(f"    [{'green' if ok else 'red'}]{'✓' if ok else '✗'}[/] [dim]{ms}ms · {first}[/dim]")

            steps.append({"tool": name, "args": args, "out": str(out)[:1200],
                          "ms": ms, "ok": ok})
            msgs.append({"role": "tool", "tool_call_id": tc.get("id"),
                         "name": name, "content": str(out)})

    return {"reply": "reached the maximum number of tool steps.", "steps": steps}


async def run_agent_stream(sess, user_text):
    """Agent loop with live step output."""
    provs = {p["name"]: p for p in get_providers()}
    prov = provs.get(sess.prov)
    if not prov:
        return {"error": f"provider not found: '{sess.prov}'"}

    system = sess.system
    if not sess.tools_on:
        system += "\n\nTools are DISABLED in this session. You have no tools; do not emit commands or tool calls. Answer from your own knowledge only."
    else:
        system += "\n\nFor any real task, call the tool via a proper tool call - never write raw JSON or a tool name inside your reply text."

    msgs = [{"role": "system", "content": system}] + sess.messages \
        + [{"role": "user", "content": user_text}]
    steps = []

    with Live(Spinner("dots12", text=Text(" thinking...", style="#64748b")),
              console=console, refresh_per_second=10, transient=True):
        for _ in range(MAX_STEPS):
            if sess.stop_flag:
                sess.stop_flag = False
                return {"reply": "stopped.", "steps": steps}
            res = await llm(prov, sess.model, msgs, tools=sess.tools_on,
                            reasoning=sess.reasoning)
            if "error" in res:
                return {"error": res["error"], "steps": steps}
            msg = res["message"] or {}
            tcs = msg.get("tool_calls") or []
            content = msg.get("content") or ""
            if not tcs:
                return {"reply": content or "(no response)", "steps": steps,
                        "usage": res.get("usage")}
            msgs.append({"role": "assistant", "content": content, "tool_calls": tcs})
            for tc in tcs:
                fn = tc.get("function") or {}
                name = fn.get("name")
                try:
                    args = json.loads(fn.get("arguments") or "{}")
                except Exception:
                    args = {}
                icon = TOOL_ICON.get(name, "🔧")
                a = json.dumps(args, ensure_ascii=False)
                a = a[:78] + "…" if len(a) > 78 else a
                console.print(f"  [#475569]┌[/#475569] [tool]{icon} {name}[/tool] "
                              f"[toolarg]{_esc(a)}[/toolarg]")
                t0 = time.time()
                fnc = TOOL_FN.get(name)
                out = (await fnc(**args)) if fnc else f"unknown tool: {name}"
                ms = int((time.time() - t0) * 1000)
                ok = not str(out).startswith(("error", "blocked", "timed out"))
                first = str(out).strip().splitlines()[0][:78] if str(out).strip() else ""
                mark = "[ok]✓[/ok]" if ok else "[err]✗[/err]"
                console.print(f"  [#475569]└[/#475569] {mark} [dim]{ms}ms · {_esc(first)}[/dim]")
                steps.append({"tool": name, "args": args, "out": str(out)[:1200],
                              "ms": ms, "ok": ok})
                msgs.append({"role": "tool", "tool_call_id": tc.get("id"),
                             "name": name, "content": str(out)})
    return {"reply": "reached the maximum number of tool steps.", "steps": steps}


