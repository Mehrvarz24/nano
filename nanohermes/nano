async def tool_run_bash(command="", **kw):
    if DANGER.search(command):
        return "⛔ دستور پرخطر — اجرا نشد."
    try:
        p = await asyncio.create_subprocess_shell(
            command, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
        try:
            out, _ = await asyncio.wait_for(p.communicate(), timeout=CMD_TIMEOUT)
        except asyncio.TimeoutError:
            p.kill()
            return f"⏱ تایم‌اوت {CMD_TIMEOUT}s"
        t = out.decode("utf-8", "replace")
        return (t[:MAX_OUTPUT] + f"\n… [{len(t)} بایت]") if len(t) > MAX_OUTPUT else (t or "(بدون خروجی)")
    except Exception as e:
        return f"خطا: {e}"


